# Kidra prod environment: non-secret settings.
# deploy/ci/deploy.sh ships this file to /srv/kidra/kidra.env on the kidra-prod VM
# on every deploy. Do NOT put secrets here (this file is public). Secrets such as
# KIDRA_ADMIN_EMAIL / KIDRA_ADMIN_PASSWORD live in /srv/kidra/secrets.env on the VM.

# Repository with the KiCad libraries that Kidra syncs (one repo for dev and prod).
KIDRA_LIBRARY_REPO=https://github.com/Supidoc/Gradur_Libraries_Test.git

# Branch to mirror. Prod mirrors 'main'. Library changes reach it by merging dev -> main in the
# library repository.
KIDRA_LIBRARY_BRANCH=main

# Pull schedule for the library repository (cron syntax).
KIDRA_LIBRARY_PULL_CRON=*/15 * * * *

# Public URL under which the reverse proxy serves this instance
# (placeholder: change it to your real hostname).
KIDRA_APP_URL=https://kidra.lan

# Set (any non-empty value) when a reverse proxy is in front of Kidra: the
# bootstrap migration then makes PocketBase read the client IP from
# X-Forwarded-For. Only applied on the first start (see README).
KIDRA_TRUSTED_PROXY=1
