# Kidra configuration reference.
#
# Two kinds of variables are listed here:
#
#  1. Compose variables (KIDRA_IMAGE, KIDRA_PORT, KIDRA_TARGET) are read by
#     `docker compose` itself. Put them in a file named `.env` next to compose.yaml.
#
#  2. Application variables (everything else) are passed into the container.
#     Put them in kidra.env (non-secret) or secrets.env (secret, chmod 600);
#     compose.yaml loads both if present. For a native install, kidra reads
#     KIDRA_ENV_FILE or <data dir>/kidra.env and never overrides variables that
#     are already set in the environment.
#
# All variables are optional. Defaults are shown in the comments.

# --- 1. Compose (.env) -------------------------------------------------------

# Image to run. Deploys pin a digest:
#   KIDRA_IMAGE=ghcr.io/supidoc/kidra@sha256:<64 hex>
# Slim variant (no kicad-cli, so no SVG previews): ghcr.io/supidoc/kidra:latest-slim
KIDRA_IMAGE=ghcr.io/supidoc/kidra:latest

# Host port published for the container's port 8090.
KIDRA_PORT=8090

# Dockerfile target for compose.build.yaml: full (default) or slim.
KIDRA_TARGET=full

# --- 2. Application (kidra.env) ---------------------------------------------

# Public base URL of this instance (PocketBase meta.appURL, used in mails/links).
#KIDRA_APP_URL=https://kidra.example.lan

# Set when running behind a reverse proxy: PocketBase then takes the client IP
# from X-Forwarded-For (only enable this if the proxy sets that header).
#KIDRA_TRUSTED_PROXY=true

# Git URL of the KiCad library repository, and how often it is pulled (cron).
#KIDRA_LIBRARY_REPO=https://github.com/OWNER/kicad-libraries.git
# Branch to mirror (default: the repository's default branch).
#KIDRA_LIBRARY_BRANCH=main
#KIDRA_LIBRARY_PULL_CRON=*/5 * * * *

# Where the library repository is cloned (default <data dir>/repositories/project).
#KIDRA_LIBRARY_PATH=/pb_data/repositories/project

# Repo-relative directory that ${KICAD*_3DMODEL_DIR} in footprints maps to.
#KIDRA_3DMODEL_DIR=3dmodels

# kicad-cli binary for symbol/footprint SVG previews (default: PATH lookup).
# The full image sets /usr/bin/kicad-cli.
#KIDRA_KICAD_CLI=/usr/bin/kicad-cli

# KiCad's stock 3D models, used for ${KICAD<n>_3DMODEL_DIR}. The full image sets
# /kicad-3dmodels; mount the models there (see compose.yaml).
#KIDRA_KICAD_STOCK_3DMODEL_DIR=/kicad-3dmodels

# "true" lets the "download from URL" proxy (/api/datasheet-download) fetch from
# private/LAN addresses.
#KIDRA_DOWNLOAD_ALLOW_PRIVATE=false

# Directory of the JS migrations (the image sets /app/pb_migrations; native
# builds default to <exe dir>/pb_migrations, then ./pb_migrations).
#KIDRA_MIGRATIONS_DIR=/app/pb_migrations

# Serve the SPA from this directory instead of the embedded copy.
#KIDRA_PUBLIC_DIR=

# --- 2b. Secrets (secrets.env, chmod 600) ------------------------------------

# Superuser created/updated by the bootstrap migration on first start. Change
# the password later with: docker compose exec kidra /app/kidra superuser upsert <email> <password> --dir=/pb_data
#KIDRA_ADMIN_EMAIL=admin@example.lan
#KIDRA_ADMIN_PASSWORD=change-me-please
